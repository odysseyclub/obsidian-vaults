
filters:
  and:
    - file.inFolder("20 디스코그래피/곡")
    - 'type == "곡"'
properties:
  file.name:
    displayName: "곡"
  타이틀여부:
    displayName: "타이틀"
  source:
    displayName: "출처 유형"
views:
  - type: cards
    name: "곡 카드"
    order:
      - file.name
      - 앨범
      - 발매일
      - 타이틀여부
    sort:
      - property: 발매일
        direction: DESC
    cardSize: 220
  - type: table
    name: "발매일 순"
    order:
      - file.name
      - 발매일
      - 앨범
      - 타이틀여부
      - 작사
      - source
      - 확인
    sort:
      - property: 발매일
        direction: ASC
  - type: table
    name: "앨범별"
    groupBy:
      property: 앨범
      direction: ASC
    order:
      - file.name
      - 발매일
      - 타이틀여부
      - 작사
      - 작곡
    sort:
      - property: 발매일
        direction: ASC
  - type: table
    name: "타이틀곡만"
    filters:
      and:
        - '타이틀여부 == true'
    order:
      - file.name
      - 발매일
      - 앨범
      - 작사
    sort:
      - property: 발매일
        direction: ASC
  - type: table
    name: "확인이 필요한 곡"
    filters:
      and:
        - '확인 == "확인 필요"'
    order:
      - file.name
      - 발매일
      - 앨범
      - source
    sort:
      - property: 발매일
        direction: ASC
